# Firebase emulator credentials — all values are FAKE, used only with the local emulator.
# Copy this file to .env.test.local before running E2E tests:
#   cp .env.test.local.example .env.test.local
#   Then: npm run test:e2e:full
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mivoa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mivoa
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
