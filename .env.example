TEST_OPENROUTER_API_KEY=your-openrouter-api-key

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Stripe Configuration
# Required for subscription features
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Price IDs - Supporter Plan
STRIPE_PRICE_ID_SUPPORTER_MONTHLY_USD=price_your-supporter-monthly-usd-price-id
STRIPE_PRICE_ID_SUPPORTER_MONTHLY_CAD=price_your-supporter-monthly-cad-price-id
STRIPE_PRICE_ID_SUPPORTER_ANNUAL_USD=price_your-supporter-annual-usd-price-id
STRIPE_PRICE_ID_SUPPORTER_ANNUAL_CAD=price_your-supporter-annual-cad-price-id

# Stripe Price IDs - Pro Plan
STRIPE_PRICE_ID_PRO_MONTHLY_USD=price_your-pro-monthly-usd-price-id
STRIPE_PRICE_ID_PRO_MONTHLY_CAD=price_your-pro-monthly-cad-price-id
STRIPE_PRICE_ID_PRO_ANNUAL_USD=price_your-pro-annual-usd-price-id
STRIPE_PRICE_ID_PRO_ANNUAL_CAD=price_your-pro-annual-cad-price-id
